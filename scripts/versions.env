# =============================================================================
# CloudBox — single source of truth for every version pin used by scripts/.
#
# Sourced by every script via scripts/lib.sh. Principle 14: pin everything.
# Tool versions (talosctl, kubectl, helm, kind, crane, cilium-cli, jq, node)
# are pinned in mise.toml — keep the two files in sync when bumping.
#
# Verified against upstream releases on 2026-08-17 — the second post-rehearsal
# drift pass, which took the seven pins that had fallen behind: mise v2026.8.6,
# helm 4.2.4, ArgoCD v3.5.1, Argo Workflows v4.1.1 (a minor), NATS 2.14.5,
# VictoriaMetrics v1.150.0, aws-cli 2.36.24 (the last of which was then dropped
# entirely later the same day — the AWS CLI was replaced by s5cmd v2.3.0, see
# docs/HAZARDS.md). `check-upstream.sh` reports all 34
# tracked rows `ok` afterwards, and every ref in images.txt resolved with crane.
# (During the pass GitHub's /releases?per_page=100 endpoint answered 504 for a
# while, which showed up as a bogus `cnpg` finding — that is what the guards'
# network-vs-finding fix now distinguishes. CNPG's `^1\.28\.` hold is
# deliberate and unchanged.)
# helm stays on 4.x with `--server-side=false` passed explicitly at all three
# call sites, so the apply path is still helm 3's proven client-side one
# (docs/HAZARDS.md — and note a helm PATCH can move the vendor render gate).
# `mise run upstream` does the looking-up (weekly in CI too);
# docs/MAINTENANCE.md is the runbook for acting on it.
# =============================================================================

# --- Tooling -------------------------------------------------------------------
# mise version installed by dev-setup.sh / CI / devcontainer (the mise.run
# installer honors MISE_VERSION). Keep the devcontainer copy in sync.
MISE_VERSION="v2026.8.6"

# --- Cluster -----------------------------------------------------------------
CLUSTER_NAME="cloudbox"
TALOS_VERSION="v1.13.8"                      # never 1.12.x — cni:none hangs (talos#12885)
TALOS_IMAGE="ghcr.io/siderolabs/talos:${TALOS_VERSION}"
KUBERNETES_VERSION="1.36.2"                  # what Talos v1.13.8 ships by default
TALOS_SUBNET="10.5.0.0/24"                   # talosctl default, pinned so the gateway
TALOS_SUBNET_GATEWAY="10.5.0.1"              # (= the host, on Linux) is predictable

# Memory limits per node container (MB). Defaults (2048) will NOT fit the stack.
TALOS_MEMORY_CONTROLPLANE="4096"
TALOS_MEMORY_WORKER="6144"

# CPU caps per node container. We do NOT cap them: both containers are given
# the Docker daemon's full CPU count, deliberately oversubscribed, so the kernel
# shares cores between them instead of a CFS quota throttling either one.
#
# talosctl defaults --cpus-{controlplanes,workers} to 2.0 each, so the cluster
# got 4 cores no matter how big the laptop was. The 2026-08-17 rehearsal wedged
# module 10's end state at /proc/pressure/cpu avg10=98.72 on only ~23% absolute
# utilisation — throttling, not saturation — and raising the caps mid-load did
# NOT rescue it. A later Kourier rollout on hand-raised caps still sat in
# ContainerCreating for ~11 minutes on the Cilium CNI ADD while the old pod
# restarted twice on liveness timeouts.
#
# Same rule we apply to our own workloads (see any postgres-cluster.yaml):
# requests are for scheduling, a CPU limit is a quota that throttles rather than
# queues. Memory limits stay — there the failure mode is OOM, not stall.
# Floor of 2.0 = talosctl's own default, so a MIN_CPUS machine is never worse off.
TALOS_CPU_FLOOR="2"

# --- Substrate ---------------------------------------------------------------
# Which machine substrate the cluster runs on. Unset lets create-cluster.sh
# detect (tbx when `tbx doctor` passes on arm64 macOS or Linux/KVM, else
# docker); the answer is written to ~/.cloudbox/substrate so destroy-cluster.sh,
# install.sh --check, lab/00, lab/01, catch-up.sh and context-guard.sh all read
# the SAME answer later instead of re-detecting a machine that has changed.
# CLOUDBOX_SUBSTRATE is deliberately NOT assigned here — versions.env is pure
# assignments and would clobber an attendee's `CLOUDBOX_SUBSTRATE=docker ./...`.
CLOUDBOX_SUBSTRATE_DEFAULT="tbx"             # go-live gate flips this to docker
                                             # if the tbx rehearsal fails

# talos-box (`tbx`) — the VM substrate. Pinned like everything else; see
# docs/MAINTENANCE.md for the bump procedure. Install: `brew install
# randax/tap/tbx` then `sudo tbx system install` (macOS), or the release
# tarball + the systemd helper (Linux, docs/linux.md upstream).
# One caveat on everything this repo claims about tbx behaviour: the upstream
# clone read while building this substrate is `v0.1.1-1-g053aecb` — the tag plus
# one commit, "Fix Linux QA battery findings: … honest doctor verdicts
# (#445–#448)" — so a verdict quoted from that source
# — `tbx doctor`'s Linux checks especially — can be one that the pinned release
# does not yet print.
TBX_VERSION="v0.1.1"

# VM sizing. UNREHEARSED as of 2026-08-24 — the rehearsal in the plan's last
# task measures peak RSS at the module-10 end state and these numbers are what
# it corrects. scripts/substrate/cloudbox.tbx.yaml.tmpl is rendered FROM them,
# so the yaml is never a second place the sizes are written down.
# Host floor stays 16 GB (MIN_DOCKER_MEMORY_GB is docker-only).
TBX_CP_MEMORY="4GiB"
TBX_CP_CPUS="4"
TBX_WORKER_MEMORY="8GiB"                     # a CEILING, not a fixed size — see below
TBX_WORKER_CPUS="4"                          # raised to max(4, NCPU-2) at render
TBX_DISK_SIZE="20GiB"

# The worker's memory is LOWERED to fit the host at render time, the same way
# TBX_WORKER_CPUS is raised:
#
#   worker_gib = clamp(host_gib - TBX_HOST_RESERVE_GIB - cp_gib,
#                      TBX_WORKER_MEMORY_FLOOR, TBX_WORKER_MEMORY)
#
# because `tbx up` REFUSES (not warns) to start a cluster whose planned VM
# memory exceeds host RAM minus its balloon reserve — checkOvercommit in
# upstream internal/daemon/balloon.go:174-202, with the 6144 MiB default from
# internal/balloon/manager.go:108-119. A 16 GB Mac is 16384 MiB, so the budget
# is 10240 MiB and the flat 4+8 = 12288 GiB pair failed EVERY 16 GB machine —
# the published minimum spec. 4+6 fits it exactly; 24 GB and up still get the
# full 8 GiB ceiling. We do NOT pass tbx's `-force`: overriding a memory gate
# on the machine that is about to run 21 apps is how a laptop swaps itself to
# death mid-workshop.
#
# The reserve mirrors tbxd's own (TBX_BALLOON_RESERVE_MIB overrides it there;
# if you tune that, tune this too — they are two views of one budget). Note the
# gate is macOS-only upstream: HostTotalMiB has no Linux implementation
# (internal/balloon/hostmem_stub.go) so checkOvercommit stands down there. We
# still scale on Linux — fitting the host is right on both.
TBX_HOST_RESERVE_GIB="6"
TBX_WORKER_MEMORY_FLOOR="4GiB"               # below this the stack does not fit
TBX_CLUSTER_FILE="${HOME}/.cloudbox/cloudbox.tbx.yaml"

# One domain for every workshop URL, on both substrates. On tbx this is
# talos-box's own cluster domain (`domain:` in the cluster yaml), whose
# wildcard resolves to the cluster's .200 ingress VIP (docs/SPEC.md:213-216).
# On docker it is a marked block in /etc/hosts pointing at 127.0.0.1.
CLOUDBOX_DOMAIN="cloudbox.k8s.test"

# Cilium's shared ingress on the docker substrate. 30880, NOT 30080 — that is
# ArgoCD's existing NodePort. create-cluster.sh publishes host 80 -> 30880 so
# the hostnames work without a port suffix on both substrates.
NODEPORT_INGRESS="30880"

# --- kind fallback (loses the Talos content, strictly more robust) -----------
KIND_NODE_IMAGE="kindest/node:v1.36.1@sha256:3489c7674813ba5d8b1a9977baea8a6e553784dab7b84759d1014dbd78f7ebd5"

# --- CNI ----------------------------------------------------------------------
# Chart vendored: scripts/manifests/cilium-${CILIUM_VERSION}.tgz — when bumping,
# re-vendor with `helm pull cilium --repo ${CILIUM_HELM_REPO} --version <new>`.
CILIUM_VERSION="1.20.0"
CILIUM_HELM_REPO="https://helm.cilium.io"

# --- GitOps -------------------------------------------------------------------
# Chart vendored: scripts/manifests/gitea-${GITEA_CHART_VERSION}.tgz — when
# bumping, re-vendor with `helm pull gitea --repo ${GITEA_HELM_REPO} --version <new>`.
GITEA_CHART_VERSION="12.7.0"                 # ships Gitea 1.27.0
GITEA_HELM_REPO="https://dl.gitea.com/charts/"
GITEA_ADMIN_USER="gitea_admin"
GITEA_ADMIN_PASSWORD="cloudbox123"           # ephemeral lab cluster — not a secret
GITEA_HOST_URL="http://gitea.${CLOUDBOX_DOMAIN}"
GITEA_CLUSTER_URL="http://gitea-http.gitea.svc.cluster.local:3000"
PLATFORM_REPO_PATH="cloudbox/platform"       # <org>/<repo>, created by push-to-create

ARGOCD_VERSION="v3.5.1"
ARGOCD_HOST_URL="http://argocd.${CLOUDBOX_DOMAIN}"

# Installed imperatively by bootstrap-gitops.sh (Gitea's PVC needs a storage
# class before GitOps exists) directly from the gitops component, which the
# wave-0 ArgoCD app adopts afterwards — single copy, cannot drift.
LOCAL_PATH_PROVISIONER_VERSION="v0.0.37"

# Knative Eventing release vendored into gitops/components/knative-eventing/
# (module 09 capstone). Documented here so images.txt re-pins have one anchor.
KNATIVE_EVENTING_VERSION="v1.23.0"

# --- Kagent (day-2 Kubernetes AI agent, module 10) ---------------------------
# Pinned chart version. Kagent does not mark v0.10.0-beta* GitHub tags as
# prereleases, so upstream's "latest release" resolves to a beta.
KAGENT_VERSION="0.9.12"
# Host-side Ollama model cloudbox-init.sh pulls for kagent's default ModelConfig;
# see GitHub issues #124/#125. Was qwen3:4b until 2026-08-18; 1.7b is smaller
# AND calls tools far more reliably (see gitops/components/kagent/VENDOR.md and
# lab/10-day2-ops/README.md for the measurements). Its ~1.4 GB is host-side and
# NOT part of the container image pre-pull budget in images.txt.
KAGENT_OLLAMA_MODEL="qwen3:1.7b"

# --- NodePorts exposed on the host --------------------------------------------
NODEPORT_GITEA="30300"
NODEPORT_ARGOCD="30080"
NODEPORT_ZOT="30500"
NODEPORT_PORTAL="30600"
NODEPORT_BACKSTAGE="30700"
NODEPORT_RUSTFS_S3="30900"
# Grafana (Victoria-stack observability) — the canonical port, freed when
# otel-lgtm was retired (#57). Browser: http://grafana.cloudbox.k8s.test.
NODEPORT_GRAFANA="30030"
NODEPORT_KOURIER="31080"
NODEPORT_NATS="30422"

# --- Browser-facing hostnames -------------------------------------------------
# One scheme, both substrates. On tbx these resolve through talos-box's own
# resolver to the cluster's .200 ingress VIP; on docker through the marked
# block create-cluster.sh writes in /etc/hosts, to 127.0.0.1:80 -> NODEPORT_INGRESS
# (install.sh prints and verifies it).
# Each has a matching gitops/components/<x>/ingress.yaml with
# ingressClassName: cilium. The NodePorts above stay published as a fallback
# and for the node-side pulls (Zot) that must NOT go through ingress.
PORTAL_HOST_URL="http://portal.${CLOUDBOX_DOMAIN}"
GRAFANA_HOST_URL="http://grafana.${CLOUDBOX_DOMAIN}"
BACKSTAGE_HOST_URL="http://backstage.${CLOUDBOX_DOMAIN}"
ZOT_HOST_URL="http://zot.${CLOUDBOX_DOMAIN}"
NATS_HOST_URL="http://nats.${CLOUDBOX_DOMAIN}"          # HTTP monitoring (:8222) only;
                                                        # the client port stays NODEPORT_NATS
RUSTFS_CONSOLE_HOST_URL="http://rustfs.${CLOUDBOX_DOMAIN}"
# The S3 API host is needed WITHOUT a scheme too: the portal signs presigned
# URLs for it (apps/portal/internal/store/s3.go trims the scheme and builds the
# signing client with Secure:false), so this must stay plain http.
RUSTFS_S3_HOST="s3.${CLOUDBOX_DOMAIN}"
RUSTFS_S3_HOST_URL="http://${RUSTFS_S3_HOST}"
# Knative's config-domain. Every ksvc becomes <name>-<ns>.kn.cloudbox.k8s.test —
# a DASH, from the domain-template curation in serving-core.yaml, which is what
# keeps the host to ONE label so a single *.kn.<domain> Ingress rule can route
# every namespace to the Kourier gateway.
KNATIVE_DOMAIN="kn.${CLOUDBOX_DOMAIN}"

# --- Image pre-pull mirror (created by cloudbox-init.sh) ----------------------
MIRROR_NAME="cloudbox-mirror"
# Repo paths (registry stripped, no tag) whose mirrored architecture install.sh
# --check must NOT compare against the node architecture: intentionally
# single-arch upstream images with no multi-arch sibling to re-pin to (see the
# images.txt comments). In the mirror they are indistinguishable from a
# wrong-arch filtered copy. Exempt from the CHECK is not "runs everywhere":
# amd64-only Backstage runs emulated on Apple Silicon Docker and not at all in
# an arm64 tbx VM, which --check warns about separately.
MIRROR_ARCH_EXEMPT="cnoe-io/backstage-app"
MIRROR_PORT="5001"
MIRROR_VOLUME="cloudbox-mirror-data"
MIRROR_IMAGE="docker.io/library/registry:3.1.1"

# --- Published minimum spec (install.sh --check thresholds) -------------------
MIN_DOCKER_MEMORY_GB="10"                    # allocatable to Docker (docker substrate)
# The published host floor (README, lab/00-setup). Docker's allocatable slice is
# meaningless on tbx — the nodes are VMs sized from the HOST's RAM by
# tbx_worker_memory() — so that substrate's preflight measures this instead.
MIN_HOST_MEMORY_GB="16"
# 4 is the gate for the CORE path (modules 00-05), which is what it has always
# been and what install.sh --check enforces. Be honest about what is measured:
# both full rehearsals ran on an 8-CPU host, so the STRETCH path (08-10, which
# is 21 apps and ~73 pods at its end state) has never been exercised on a
# 4-core machine. Uncapping the node containers means such a machine now gets
# 4/4 where it previously got 2/2 — strictly better than any attendee has had
# — but "better than before" is not "measured". See docs/HAZARDS.md.
MIN_CPUS="4"
MIN_DISK_FREE_GB="40"
