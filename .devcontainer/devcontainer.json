// Dev container for the JavaZone 2026 workshop — the "lifeboat" path (PLAN.md decision 1).
// If `./scripts/install.sh --check` fails on your laptop, open this repo in GitHub
// Codespaces (4-core / 16 GB machine or larger) or any Dev Containers-spec editor and
// you get the same workshop content with Docker-in-Docker.
// Spec reference: https://containers.dev/implementors/json_reference/
{
  "name": "jz-2026-platform-engineering",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",

  "features": {
    // Talos-in-Docker needs a real Docker daemon inside the container.
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },

  // Codespaces machine-type hint: the published workshop spec is 16 GB RAM
  // (>=10 GB to Docker), 4+ cores, 40 GB disk. Storage below is the Codespaces
  // minimum that fits the pre-pulled images; local users need 40 GB free.
  "hostRequirements": {
    "cpus": 4,
    "memory": "16gb",
    "storage": "32gb"
  },

  // Codespaces and dev containers are Docker-in-Docker: there is no hypervisor
  // and no KVM, so the tbx substrate cannot run here. Pinning it explicitly
  // means the dispatcher never even probes for tbx — and the lifeboat behaves
  // identically to every CI run, which is what makes it a tested path.
  "containerEnv": {
    "CLOUDBOX_SUBSTRATE": "docker"
  },

  // Install mise, hook it into the shell, then install the pinned toolchain.
  //
  // The `mise activate` line is not a nicety: mise.run only PRINTS the activation
  // instruction, and postCreateCommand's PATH export dies with the command. Without
  // it, a terminal in this container has the mise binary but none of the tools it
  // installed (talosctl, kubectl, helm) and none of mise.toml's [env] — including
  // the KUBECONFIG pin. dev-setup.sh offers to add the same line interactively and
  // is idempotent, so it will report "already there" rather than duplicate it.
  //
  // NOTE: `./scripts/cloudbox-init.sh` (pre-pull several GB of images) is deliberately
  // NOT run automatically — it is too heavy for container creation. Run it manually
  // once inside the container, before the workshop:
  //   ./scripts/cloudbox-init.sh && ./scripts/install.sh --check
  // MISE_VERSION pin: keep in sync with scripts/versions.env
  // The /etc/hosts block create-cluster.sh writes lands inside the container, which
  // is where the browser preview resolves from — nothing to do on the Codespaces host.
  "postCreateCommand": "curl -fsSL https://mise.run | MISE_VERSION=v2026.8.6 sh && export PATH=\"$HOME/.local/bin:$PATH\" && printf '\\n# mise (CloudBox workshop tools + KUBECONFIG)\\neval \"$($HOME/.local/bin/mise activate bash)\"\\n' >> \"$HOME/.bashrc\" && ./scripts/dev-setup.sh",

  // NodePorts exposed by the in-cluster platform.
  "forwardPorts": [80, 30300, 30080, 30500, 30600, 30700, 30900, 30030, 31080, 30422],
  "portsAttributes": {
    "80": { "label": "Platform ingress (*.cloudbox.k8s.test)" },
    "30030": { "label": "Grafana" },
    "30300": { "label": "Gitea (in-cluster git)" },
    "30080": { "label": "ArgoCD" },
    "30500": { "label": "Zot registry" },
    "30600": { "label": "Cloudbox Console" },
    "30700": { "label": "Backstage portal" },
    "30900": { "label": "RustFS S3" },
    "31080": { "label": "App ingress (Kourier)" },
    "30422": { "label": "NATS (JetStream)" }
  },

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-kubernetes-tools.vscode-kubernetes-tools",
        "redhat.vscode-yaml"
      ],
      "settings": {
        "files.eol": "\n"
      }
    }
  }
}
